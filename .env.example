# Copy this file to `.env.local` and fill in real values. Never commit real keys.
# Anything left empty is simply hidden on the site — nothing is invented.

# Contact form: a POST endpoint that accepts JSON and returns 2xx on success.
# Examples: https://formspree.io/f/xxxxxxx  ·  https://api.web3forms.com/submit
VITE_CONTACT_ENDPOINT=
# Only for services that need it in the request body (e.g. Web3Forms).
VITE_CONTACT_ACCESS_KEY=

# WhatsApp: international format, digits only, no + or spaces (e.g. 91XXXXXXXXXX).
VITE_WHATSAPP_NUMBER=
# Phone number exactly as it should be displayed (e.g. +91 XXXXX XXXXX).
VITE_PUBLIC_PHONE=

# Social profiles (full URLs). Empty ones are not shown.
VITE_SOCIAL_INSTAGRAM=
VITE_SOCIAL_LINKEDIN=
VITE_SOCIAL_FACEBOOK=
VITE_SOCIAL_YOUTUBE=
VITE_SOCIAL_PINTEREST=

# Public site URL, used at build time for canonical/Open Graph URLs, JSON-LD
# and sitemap.xml (no trailing slash), e.g. https://www.example.com
SITE_URL=
